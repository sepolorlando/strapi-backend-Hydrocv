{
  "kind": "collectionType",
  "collectionName": "servicos",
  "info": {
    "singularName": "servico",
    "pluralName": "servicos",
    "displayName": "Serviço",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
