      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "icone": {
      "type": "enumeration",
      "enum": [
        "sprout",
        "leaf",
        "apple",
        "check",
        "users",
        "award",
        "headphones",
        "shield",
        "wrench",
        "credit-card",
        "settings",
        "message",
        "tag",
        "help",
        "flask",
        "heart"
      ]
    },
    "ordem": {
      "type": "integer",
      "default": 0
    },
    "destaque": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "required": false,
      "component": "shared.seo"
    }
  }
