{
  "kind": "collectionType",
  "collectionName": "categorias_faq",
  "info": {
    "singularName": "categoria-faq",
    "pluralName": "categorias-faq",
    "displayName": "Categoria FAQ",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "icone": {
      "type": "enumeration",
      "enum": [
        "sprout",
        "leaf",
        "apple",
        "check",
        "users",
        "award",
        "headphones",
        "shield",
        "wrench",
        "credit-card",
        "settings",
        "message",
        "tag",
        "help",
        "flask",
        "heart"
      ]
    },
    "ordem": {
      "type": "integer",
      "default": 0
    },
    "perguntas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::pergunta-faq.pergunta-faq",
      "mappedBy": "categoria"
    }
  }
}
