{
  "kind": "collectionType",
  "collectionName": "projetos_doacao",
  "info": {
    "singularName": "projeto-doacao",
    "pluralName": "projetos-doacao",
    "displayName": "Projeto de Doação",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "descricaoLonga": {
      "type": "richtext"
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "metaValor": {
      "type": "decimal"
    },
    "valorAngariado": {
      "type": "decimal",
      "default": 0
    },
    "moeda": {
      "type": "string",
      "default": "CVE"
    },
    "estado": {
      "type": "enumeration",
      "enum": ["ativo", "concluido", "pausado"],
      "default": "ativo"
    },
    "ordem": {
      "type": "integer",
      "default": 0
    },
    "doacoes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::doacao.doacao",
      "mappedBy": "projetoDoacao"
    }
  }
}
